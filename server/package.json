{
  "name": "@ai-center-line/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Phase 1 後端服務（NestJS/PG/RLS）。CLI 原型仍在專案根 src/。",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file=.env dist/main.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "seed:dev": "tsx --env-file-if-exists=.env src/db/seed-dev.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/db/seed-demo.ts",
    "test": "node --import tsx --env-file=.env --test test/*.test.ts",
    "test:cov": "node --import tsx --env-file=.env --test --experimental-test-coverage test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/schedule": "^6.1.3",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.48.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
