# 應用連線：最小權限角色 app_rw（受 RLS 約束，不可繞過租戶隔離）
DATABASE_URL=postgres://app_rw:app_rw_pw@localhost:5432/aicl

# 僅 dev：跑 migration 用的擁有者連線（建表/RLS/角色需 owner 權限）。
# prod 的 migration 由人工執行 SQL（R10），不用此變數自動跑。
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aicl

REDIS_URL=redis://localhost:6379

# JWT（M1 HTTP 層用）
JWT_SECRET=dev-only-change-me
