# 應用連線：最小權限角色 app_rw（受 RLS 約束，不可繞過租戶隔離）
DATABASE_URL=postgres://app_rw:app_rw_pw@localhost:5432/aicl

# 僅 dev：跑 migration 用的擁有者連線（建表/RLS/角色需 owner 權限）。
# prod 的 migration 由人工執行 SQL（R10），不用此變數自動跑。
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aicl

REDIS_URL=redis://localhost:6379

# JWT（M1 HTTP 層用）
JWT_SECRET=dev-only-change-me

# ============================================================
# LINE 通知模組（notify/）— Ragic → backend → LINE Push API
# Phase 1 首客：台灣福祉（Ragic 帳號 2026carhouse）
# 架構：Ragic Workflow 於「儲存 / 動作按鈕」呼叫本 backend endpoint，
#      由 backend 組訊息 + 呼叫 LINE Messaging API Push Message。
# 多租戶化：目前為單租戶 env；日後改為 per-tenant DB config（見 docs/modules/notify.md）。
# ============================================================

# LINE Messaging API — 「台灣福祉 AI客服」官方帳號 Channel Access Token
# 取得：LINE Developers Console → Messaging API → Channel access token（申請長期有效權杖）
LINE_CHANNEL_ACCESS_TOKEN=

# 業助群 Group ID
# 取得：官方帳號加入群組後，於群組發一則訊息 → 讀 webhook 事件的 source.groupId
# 一次取得長期沿用，不需每次重抓
LINE_GROUP_ID_BUSINESS_ASSIST=

# Ragic → 本 backend endpoint 共享密鑰（防止 endpoint 被外部亂打）
# 建議 32+ 位隨機字元；Ragic Workflow 內用 setHeader('X-Notify-Secret', 此值)
NOTIFY_WEBHOOK_SECRET=

# Ragic API 基本資訊（backend 主動回拉資料 / 對帳時使用）
# 客戶 Ragic — 台灣福祉正式帳號（真實 PII，慎用）
# 若 Ragic Workflow 已於 payload 內把所需欄位傳完整，此區塊可先留空
RAGIC_BASE_URL=https://ap16.ragic.com
RAGIC_ACCOUNT=2026carhouse
RAGIC_API_KEY=

# ---- 我司測試用 Ragic 帳號 ----
# 用途：接客戶匯出資料的沙箱環境；LINE 通知模組 dev/測試對接的目標
# 例：URL=https://ap8.ragic.com  ACCOUNT=my-test-db
RAGIC_TEST_BASE_URL=
RAGIC_TEST_ACCOUNT=
RAGIC_TEST_API_KEY=
